{
  "name": "personal-device-scanner-mcp",
  "version": "0.7.0",
  "description": "MCP server that lets AI agents inspect your own PC and Android device read-only with osquery, ClamAV, Wazuh and adb (runs the Python server; needs Python 3.11+)",
  "license": "MIT",
  "author": "tedorigawa001",
  "homepage": "https://github.com/tedorigawa001/PersonalDeviceScanner-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedorigawa001/PersonalDeviceScanner-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/tedorigawa001/PersonalDeviceScanner-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "osquery",
    "clamav",
    "wazuh",
    "android"
  ],
  "bin": {
    "personal-device-scanner-mcp": "npm/launcher.js"
  },
  "files": [
    "npm/launcher.js",
    "pc_scanner/*.py",
    "requirements-agent.lock",
    "profiles/*/requirements-agent.lock"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "test": "node --test npm/test/launcher.test.js npm/test/roundtrip.test.js"
  }
}
